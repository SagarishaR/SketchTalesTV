const {execFile} = require('child_process');
const {promisify} = require('util');
const path = require('path');
const fs = require('fs');

const execFileAsync = promisify(execFile);
const audioDir = path.join(__dirname, 'public', 'audio');

async function narrate(text, filename) {
  fs.mkdirSync(audioDir, {recursive: true});

  const safeName = path.basename(filename)
    .replace(/\.aiff$/i, '')
    .replace(/\.m4a$/i, '') + '.m4a';

  const outputPath = path.join(audioDir, safeName);
  const tempPath = outputPath.replace(/\.m4a$/i, '.aiff');

  await execFileAsync('/usr/bin/say', [
    '-v', 'Samantha',
    '-o', tempPath,
    text,
  ]);

  try {
    await execFileAsync('/usr/bin/afconvert', [
      tempPath,
      outputPath,
      '-f', 'm4af',
      '-d', 'aac',
    ]);
  } finally {
    fs.rmSync(tempPath, {force: true});
  }

  return `/audio/${safeName}`;
}

module.exports = {narrate};
